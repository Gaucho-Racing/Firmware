---
Checks: 'clang-analyzer-*, cppcoreguidelines-*, modernize-*, readability-*, bugprone-*'
WarningsAsErrors: ''
HeaderFilterRegex: '^(src|include)/'
FormatStyle: file
CheckOptions:
  - key: readability-header-guard.HeaderGuardStyle
    value: LLVM
  - key: readability-header-guard.IncludeGuards
    value: 1

  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'

  - key: readability-identifier-naming.IgnoreMainLikeFunctions
    value: 1
  - key: readability-identifier-naming.IgnoreOverriddenFunctions
    value: 1

  - key: performance-for-range-copy.WarnOnAllAutoCopies
    value: 1
