                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Address/data multiplexed on databus (default after reset)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
