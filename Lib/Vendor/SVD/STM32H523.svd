                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Real divider value is = (I2SDIV * 2) + 1</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
