                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>invalidate entire cache (all cache lines valid bit = 0)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CACHECMD</name>
