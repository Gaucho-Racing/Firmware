                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Calibration output disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Calibration output enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
