</description>
              <bitOffset>17</bitOffset>
              <bitWidth>7</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>MTYPE</name>
              <description>Message type (whatever I3C acts as controller/target)
</description>
              <bitOffset>27</bitOffset>
              <bitWidth>4</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0_WHEN_I3C_ACTS_AS_I3C_CONTROLLER</name>
                  <description>SCL clock is forced to stop until a next control word is executed</description>
                  <value>0x0</value>
