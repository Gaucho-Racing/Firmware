</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Data latency of 2 CLK clock cycles for first burst access</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xF</name>
                  <description>Data latency of 17 CLK clock cycles for first burst access (default value after reset)</description>
                  <value>0xF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACCMOD</name>
              <description>Access mode
</description>
              <bitOffset>28</bitOffset>
              <bitWidth>2</bitWidth>
