                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>High-speed IO at low Vless thansub&gt;DDIO2less than/sub&gt; voltage feature enabled (Vless thansub&gt;DDIO2less than/sub&gt; remains below 2.</description>
                  <value>0x1</value>
