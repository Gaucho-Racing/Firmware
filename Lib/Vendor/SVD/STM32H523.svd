                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>NWAIT signal is active during wait state (not used for PSRAM).</description>
                  <value>0x1</value>
                </enumeratedValue>
