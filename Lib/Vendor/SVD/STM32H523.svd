              <name>TAMPTS</name>
              <description>Activate timestamp on tamper detection event
</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
