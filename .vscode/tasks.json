{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "nodePosition",
			"type": "pickString",
			"description": "Select Node ID:",
			"options": [
				"0",
				"1",
				"2",
				"3"
			],
			"default": "0"
		}
	],
	"tasks": [
		{
			"label": "CMake: configure and build all",
			"dependsOrder": "sequence",
			"dependsOn": [
				"CMake: configure",
				"CMake: build"
			]
		},
		{
			"label": "CMake: build active target (with NODE)",
			"type": "shell",
			"command": "cmake --preset ${command:cmake.activeBuildPresetName} -DNODE:STRING=${input:nodePosition} && cmake --build --preset ${command:cmake.activeBuildPresetName} --target ${command:cmake.buildTargetName}"
		},
		{
			"label": "CMake: build active target",
			"type": "shell",
			"dependsOn": [
				"CMake: configure"
			],
			"command": "cmake --build --preset ${command:cmake.activeBuildPresetName} --target ${command:cmake.buildTargetName}"
		}
	]
}
