{
	"C_Cpp.default.intelliSenseMode": "gcc-arm",
	"files.associations": {
		"*.h": "c",
		"*.c": "c",
		"*.cmake": "cmake",
		"CMakeLists.txt": "cmake",
		"*.ld": "ld",
		"*.s": "asm",
		"initializer_list": "c",
		"type_traits": "c",
		"xutility": "c"
	},
	"C_Cpp.default.cStandard": "gnu11",
	"markdown.validate.enabled": true
}
