{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "OpenOCD (G474 160 MHz)",
			"type": "cortex-debug",
			"request": "launch",
			"servertype": "openocd",
			"cwd": "${workspaceFolder}",
			"executable": "${command:cmake.launchTargetPath}",
			"configFiles": [
				"interface/stlink.cfg",
				"target/stm32g4x.cfg"
			],
			"searchDir": [],
			"showDevDebugOutput": "raw",
			"svdPath": "${workspaceFolder}/Lib/Vendor/SVD/STM32G474.svd",
			"preLaunchTask": "CMake: build active target",
			"swoConfig": {
				"enabled": true,
				"cpuFrequency": 160000000,
				"swoFrequency": 2000000,
				"source": "probe",
				"decoders": [
					{
						"type": "console",
						"label": "ITM",
						"showOnStartup": true,
						"port": 0,
						"encoding": "ascii"
					}
				]
			}
		},
