	],
	"inputs": [
		{
			"id": "targetMcuConfig",
			"type": "pickString",
			"description": "Select Target Config:",
			"options": [
				"stm32g4x",
				"stm32l4x",
				"stm32u5x"
			]
		},
		{
			"id": "svdDevice",
			"type": "pickString",
			"description": "Select Target SVD Device:",
			"options": [
				"STM32G474",
				"STM32G431",
				"STM32L476",
				"STM32U5A9"
			]
		},
		{
			"id": "cpuFrequency",
			"type": "pickString",
			"description": "Select Core CPU Clock Frequency (MHz):",
			"options": [
				"160",
				"80"
			]
		}
	]
