{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Active Target (OpenOCD)",
			"type": "cortex-debug",
			"request": "launch",
			"servertype": "openocd",
			"cwd": "${workspaceFolder}",
			"executable": "${command:cmake.launchTargetPath}",
			"configFiles": [
				"interface/stlink.cfg",
				"target/${input:targetMcuConfig}.cfg"
			],
			"searchDir": [],
			"showDevDebugOutput": "raw",
			"svdPath": "${workspaceFolder}/Lib/Vendor/SVD/${input:svdDevice}.svd",
			"preLaunchTask": "CMake: build active target",
			"swoConfig": {
				"enabled": true,
				"cpuFrequency": "${input:cpuFrequency}",
				"swoFrequency": 2000000,
				"source": "probe",
				"decoders": [
					{
						"type": "console",
						"label": "ITM",
						"showOnStartup": true,
						"port": 0,
						"encoding": "ascii"
					}
				]
			}
		},
		{
			"name": "Active Target (ST-Util)",
			"type": "cortex-debug",
