routing:
  messages:
    ACU:
      CAN1:
        Debugger:
          - msg: Debug 2.0
          - msg: Ping
        ECU:
          - msg: Ping
          - msg: ACU Status 1
          - msg: ACU Status 2
          - msg: ACU Status 3
          - msg: DC-DC Status
      CAN2:
        Debugger:
          - msg: Debug FD
          - msg: Ping
        ECU:
          - msg: Ping
          - msg: ACU Cell Data 1
          - msg: ACU Cell Data 2
          - msg: ACU Cell Data 3
          - msg: ACU Cell Data 4
          - msg: ACU Cell Data 5
      CAN3:
        Charger:
          - msg: Charger Control
            can_id_override: 0x1806E5F4
    Charger:
      CAN3:
        ACU:
          - msg: Charger Data
            can_id_override: 0x18FF50E5
    Dash Panel:
