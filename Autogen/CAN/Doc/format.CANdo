          - msg: Ping
        Fan Controller 8:
          - msg: Debug 2.0
          - msg: Ping
        LV DC-DC:
          - msg: Debug 2.0
          - msg: Ping
          - msg: Ping
      CAN2:
        ECU:
          - msg: Debug FD
          - msg: Ping
        ACU:
          - msg: Debug FD
          - msg: Ping
        TCM:
          - msg: Debug FD
          - msg: Ping
        Steering Wheel:
          - msg: Debug FD
          - msg: Ping
        SAM1:
          - msg: Debug FD
          - msg: Ping
        SAM2:
          - msg: Debug FD
